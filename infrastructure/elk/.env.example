# Copy to /opt/elastic/.env (mode 600). Never commit real values.
STACK_VERSION=9.5.6
COMPOSE_PROJECT_NAME=elastic
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
# Each Kibana key: 32+ random characters (openssl rand -hex 32)
KIBANA_SECURITY_KEY=
KIBANA_ESO_KEY=
KIBANA_REPORTING_KEY=
KIBANA_PUBLIC_URL=https://192.168.1.60:5601
ES_PUBLIC_URL=https://192.168.1.60:9200
FLEET_URL=https://192.168.1.60:8220
# Filled in by bootstrap.sh
CA_FINGERPRINT=
FLEET_SERVER_SERVICE_TOKEN=
# Filled in by setup-logstash.sh
LOGSTASH_WRITER_PASSWORD=
SOC_ANALYST_PASSWORD=
